{
  "name": "household-ui",
  "version": "0.1.0",
  "description": "Shared Preact UI components and Material 3 theme for the Household apps.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "src",
    "scripts",
    "!src/**/*.test.*",
    "!src/test",
    "!src/testing"
  ],
  "exports": {
    "./ui/*.tsx": "./src/ui/*.tsx",
    "./ui/*.ts": "./src/ui/*.ts",
    "./ui/*.css": "./src/ui/*.css",
    "./shell/*.tsx": "./src/shell/*.tsx",
    "./shell/*.css": "./src/shell/*.css"
  },
  "bin": {
    "household-theme": "./scripts/household-theme.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.3.0"
  },
  "peerDependencies": {
    "@iconify-json/material-symbols": "^1.2.93",
    "preact": "^10.29.8",
    "unplugin-icons": "^24.0.0"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.93",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^30.1.1",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
